---
import Base from '../layouts/Base.astro';
import Softkey from '../components/Softkey.astro';
---

<Base title="404" description="Nothing at this address." bare>
  <div class="frame">
    <span class="edge top" aria-hidden="true"></span>
    <span class="edge bottom" aria-hidden="true"></span>
    <span class="edge left" aria-hidden="true"></span>
    <span class="edge right" aria-hidden="true"></span>

    <div class="core">
      <svg class="reticle" width="150" height="150" viewBox="0 0 150 150" fill="none" aria-hidden="true">
        <circle cx="75" cy="75" r="30" stroke="var(--phos)" stroke-width="1"></circle>
        <circle
          cx="75"
          cy="75"
          r="54"
          stroke="var(--line-bright)"
          stroke-width="1"
          stroke-dasharray="4 7"></circle>
        <path d="M75 8v26M75 116v26M8 75h26M116 75h26" stroke="var(--phos)" stroke-width="1"></path>
        <path
          d="M60 45h-15v-15M90 45h15v-15M60 105h-15v15M90 105h15v15"
          stroke="var(--phos)"
          stroke-width="1"></path>
      </svg>

      <p class="code">404</p>
      <h1 class="status">NO TARGET ACQUIRED</h1>
      <p class="copy">
        Nothing at this address. It may have moved to the archive shelf, or it may never have
        existed.
      </p>

      <div class="keys">
        <Softkey href="/" label="RETURN TO HUD" variant="primary" />
        <Softkey href="/logs" label="SEARCH LOGS" />
      </div>
    </div>
  </div>
</Base>

<style>
  .frame {
    position: relative;
    min-height: 620px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .edge {
    position: absolute;
    background-image: repeating-linear-gradient(
      var(--angle),
      var(--tick) 0 1px,
      transparent 1px 26px
    );
  }

  .top,
  .bottom {
    --angle: 90deg;
    left: 0;
    right: 0;
    height: 7px;
  }

  .top {
    top: 26px;
  }

  .bottom {
    bottom: 26px;
  }

  .left,
  .right {
    --angle: 180deg;
    top: 0;
    bottom: 0;
    width: 7px;
  }

  .left {
    left: 26px;
  }

  .right {
    right: 26px;
  }

  .core {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    text-align: center;
    padding: 0 40px;
  }

  .reticle {
    width: 150px;
    height: 150px;
  }

  .code {
    font-family: var(--font-chrome);
    font-size: 34px;
    letter-spacing: 0.12em;
    color: var(--phos-bright);
  }

  .status {
    font-family: var(--font-chrome);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--phos);
  }

  .copy {
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-dim);
    max-width: 400px;
  }

  .keys {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
  }

  @media (max-width: 720px) {
    .frame {
      min-height: 520px;
    }

    .top {
      top: 16px;
    }

    .left {
      left: 16px;
    }

    .right {
      right: 16px;
    }

    .bottom {
      bottom: 16px;
    }

    .core {
      gap: 20px;
      padding: 0 34px;
    }

    .reticle {
      width: 110px;
      height: 110px;
    }

    .code {
      font-size: 28px;
    }

    .copy {
      font-size: 13px;
    }
  }
</style>
