---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import PanelHeader from '../../components/PanelHeader.astro';
import Prose from '../../components/Prose.astro';
import MetaTable from '../../components/MetaTable.astro';
import LogRow from '../../components/LogRow.astro';
import { allProjects, logsByProject } from '../../lib/content';
import type { MetaRow } from '../../lib/types';

export const getStaticPaths = (async () => {
  const projects = await allProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { name, blurb, status, started, ended, stack, source, demo } = project.data;

const { Content } = await render(project);
const entries = await logsByProject(project.id);

const statusTone = status === 'wip' ? 'amber' : status === 'dormant' ? 'value' : 'phos';

const rows: MetaRow[] = [
  { label: 'STATUS', value: status.toUpperCase(), tone: statusTone },
  { label: 'STARTED', value: started },
  ...(ended ? [{ label: 'ENDED', value: ended } as MetaRow] : []),
  ...(stack.length ? [{ label: 'STACK', value: stack.join(' · ') } as MetaRow] : []),
  ...(source
    ? [{ label: 'SOURCE', value: 'github', href: source, external: true, tone: 'phos' } as MetaRow]
    : []),
  ...(demo
    ? [
        {
          label: 'DEMO',
          value: new URL(demo).host,
          href: demo,
          external: true,
          tone: 'phos',
        } as MetaRow,
      ]
    : []),
];
---

<Base
  title={name}
  description={blurb}
  active="WORKSHOP"
  back={{ label: 'WORKSHOP', href: '/workshop' }}
  gap={24}
>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/workshop">WORKSHOP</a>
    <span aria-hidden="true">▸</span>
    <span class="here">{name.toUpperCase()}</span>
  </nav>

  <Panel bracket="full" size={11} tone="bright" pad="26px 28px" padSm="18px 16px">
    <div class="head">
      <div class="lead">
        <h1 class="name">{name}</h1>
        <Prose class="desc">
          <Content />
        </Prose>
      </div>
      <MetaTable rows={rows} variant="ruled" />
    </div>
  </Panel>

  {
    entries.length > 0 && (
      <section aria-labelledby="entries-head">
        <PanelHeader
          as="h2"
          variant="section"
          label="LOG ENTRIES"
          meta={`${entries.length} ${entries.length === 1 ? 'ENTRY' : 'ENTRIES'} · ${project.id.toUpperCase()}`}
          id="entries-head"
        />
        <div class="rows">
          {entries.map((entry) => (
            <LogRow entry={entry} dateFormat="full" compact />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--label);
  }

  .crumb a {
    color: var(--label);
  }

  .crumb a:hover {
    color: var(--phos-bright);
  }

  .here {
    color: var(--text-dim);
  }

  .head {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 44px;
    align-items: start;
  }

  .name {
    font-family: var(--font-chrome);
    font-weight: 500;
    font-size: 25px;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--text);
    margin-bottom: 14px;
  }

  .lead :global(.desc) {
    max-width: 640px;
    line-height: 1.85;
  }

  .rows {
    border-top: 1px solid var(--line-bright);
    margin-top: 10px;
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }

  @media (max-width: 720px) {
    .name {
      font-size: 19px;
    }
  }
</style>
