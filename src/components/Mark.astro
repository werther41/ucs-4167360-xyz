---
/* The Logo. RWR indicator */
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26 26" class="mark">
  <path
    fill="none"
    stroke="var(--phos)"
    stroke-width="var(--mark-stroke)"
    d="M13 1.04 24.96 13 13 24.96 1.04 13z"></path>
  <path
    d="M8.58 9.62 13 6.76l4.42 2.86"
    fill="none"
    stroke="var(--phos)"
    stroke-width="var(--mark-stroke)"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <text
    x="13"
    y="14"
    font-family="'Arial', 'Helvetica', sans-serif"
    font-size="7"
    font-weight="bold"
    fill="var(--phos)"
    text-anchor="middle"
    dominant-baseline="central">UC</text
  >
</svg>

<style>
  .mark {
    --mark-stroke: 1;
    width: 30px;
    height: 30px;
    flex: none;
  }

  @media (max-width: 720px) {
    .mark {
      /* A 1px stroke shrinks with the viewBox; bump it to hold the weight. */
      --mark-stroke: 1.2;
      width: 24px;
      height: 24px;
    }
  }
</style>
