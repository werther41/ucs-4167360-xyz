---
/* The wordmark glyph: a hex shell around a filled core. */
---

<svg class="mark" viewBox="0 0 22 22" fill="none" aria-hidden="true">
  <path d="M11 1.4 20.1 6.6v10.4L11 20.6 1.9 17V6.6z" stroke="var(--phos)" stroke-width="var(--mark-stroke)"></path>
  <path d="M11 7.4 15 9.7v4.6L11 16.6 7 14.3V9.7z" fill="var(--phos)"></path>
</svg>

<style>
  .mark {
    --mark-stroke: 1;
    width: 22px;
    height: 22px;
    flex: none;
  }

  @media (max-width: 720px) {
    .mark {
      /* A 1px stroke shrinks with the viewBox; bump it to hold the weight. */
      --mark-stroke: 1.2;
      width: 18px;
      height: 18px;
    }
  }
</style>
