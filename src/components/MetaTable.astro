---
import type { MetaRow } from '../lib/types';

interface Props {
  rows: MetaRow[];
  /** ruled = divider between rows (project header), plain = gapped list (rails). */
  variant?: 'plain' | 'ruled';
  size?: 12 | 13;
  class?: string;
}

const { rows, variant = 'plain', size = 12, class: className } = Astro.props;
---

<dl class:list={['meta', variant, className]} style={`--meta-size:${size}px`}>
  {
    rows.map((row) => (
      <div class="row">
        <dt>{row.label}</dt>
        <dd class:list={[`tone-${row.tone ?? 'value'}`]}>
          {row.href ? (
            <a
              href={row.href}
              target={row.external ? '_blank' : undefined}
              rel={row.external ? 'noopener noreferrer' : undefined}
            >
              {row.value}
              {row.external && <span aria-hidden="true"> ↗</span>}
            </a>
          ) : (
            row.value
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .meta {
    font-size: var(--meta-size);
    margin: 0;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  dt {
    color: var(--label);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  dd {
    margin: 0;
    text-align: right;
  }

  .tone-value {
    color: var(--text-value);
  }

  .tone-phos {
    color: var(--phos);
  }

  .tone-amber {
    color: var(--amber);
  }

  dd a {
    color: inherit;
  }

  dd a:hover {
    color: var(--phos-bright);
  }

  .plain {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .ruled .row {
    padding: 11px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .ruled .row:last-child {
    border-bottom: 0;
  }
</style>
