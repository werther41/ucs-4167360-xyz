---
import { nav, type NavKey } from '../site';

interface Props {
  active?: NavKey;
  label?: string;
}

const { active, label = 'Primary' } = Astro.props;
---

<nav class="keys" aria-label={label}>
  {
    nav.map((item) => (
      <a
        href={item.href}
        class:list={['key', { 'is-active': item.label === active }]}
        aria-current={item.label === active ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))
  }
</nav>

<style>
  .keys {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .key {
    border: 1px solid var(--line-bright);
    padding: 11px 0;
    text-align: center;
    font-family: var(--font-chrome);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--label-dim);
  }

  .key:hover {
    border-color: var(--phos);
    color: var(--phos-bright);
  }

  .key.is-active {
    border-color: var(--phos);
    background: var(--phos-wash);
    color: var(--phos-bright);
  }

  @media (max-width: 720px) {
    .keys {
      gap: 5px;
    }

    .key {
      /* Design floor for tap targets is 44px. */
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 2px;
      font-size: 9px;
      letter-spacing: 0.08em;
    }
  }
</style>
