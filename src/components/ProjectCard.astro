---
import Panel from './Panel.astro';
import Badge from './Badge.astro';
import { yearRange, type Project } from '../lib/content';

interface Props {
  project: Project;
  entryCount: number;
  /** The workshop grid shows tags; the HUD featured row does not. */
  showTags?: boolean;
}

const { project, entryCount, showTags = false } = Astro.props;
const { name, blurb, status, started, ended, tags } = project.data;

/* An open-ended "2005 —" would claim a dormant project is still running. */
const years = status === 'dormant' ? yearRange(started, ended) : `${started.slice(0, 4)} —`;
---

<Panel
  as="a"
  href={`/workshop/${project.id}`}
  bracket="corners"
  size={9}
  tone="bright"
  hover
  pad="18px"
  class="card"
>
  <span class="top">
    <span class="year">{years}</span>
    <Badge kind={status} size="card" />
  </span>

  <span class="name">{name}</span>
  <span class="blurb">{blurb}</span>

  {
    showTags && tags.length > 0 && (
      /* Spans, not links: the whole card is already an anchor. */
      <span class="tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </span>
    )
  }

  <span class="count">
    {entryCount} {entryCount === 1 ? 'LOG ENTRY' : 'LOG ENTRIES'}
  </span>
</Panel>

<style>
  .card {
    display: block;
    color: inherit;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .year {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--label);
  }

  .name {
    display: block;
    font-size: 17px;
    color: var(--text);
    margin-bottom: 8px;
  }

  .card:hover .name {
    color: var(--phos-bright);
  }

  .blurb {
    display: block;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-dim);
    margin-bottom: 16px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .tag {
    border: 1px solid var(--line-bright);
    padding: 4px 7px;
    font-size: 10px;
    color: var(--text-mute);
  }

  .count {
    display: block;
    border-top: 1px dashed var(--line-bright);
    padding-top: 11px;
    font-size: 11px;
    color: var(--label);
  }

  @media (max-width: 720px) {
    .top {
      margin-bottom: 11px;
    }

    .name {
      font-size: 15px;
      margin-bottom: 6px;
    }

    .blurb {
      font-size: 12px;
      line-height: 1.65;
    }
  }
</style>
