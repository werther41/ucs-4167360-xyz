---
import { formatFull, formatShort, type Log } from '../lib/content';

interface Props {
  entry: Log;
  /** Year-grouped lists show MM.DD; standalone lists show the full date. */
  dateFormat?: 'short' | 'full';
  /** Drops the summary and tightens the row, as on a project page. */
  compact?: boolean;
  class?: string;
}

const { entry, dateFormat = 'short', compact = false, class: className } = Astro.props;
const { title, date, summary } = entry.data;
---

<a href={`/logs/${entry.id}`} class:list={['row', { compact }, className]}>
  <time class="date" datetime={date.toISOString()}>
    {dateFormat === 'full' ? formatFull(date) : formatShort(date)}
  </time>
  <span class="body">
    <span class="title">{title}</span>
    {!compact && <span class="summary">{summary}</span>}
  </span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 0 22px;
    padding: 18px 0;
    border-top: 1px solid var(--line-soft);
    color: inherit;
  }

  .row:hover {
    background: var(--phos-hover-soft);
  }

  .date {
    font-size: 12px;
    color: var(--label);
    padding-top: 3px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .title {
    font-size: 17px;
    color: var(--text);
  }

  .row:hover .title {
    color: var(--phos-bright);
  }

  .summary {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-dim);
    max-width: 720px;
  }

  .compact {
    padding: 15px 0;
    border-top: 0;
    border-bottom: 1px solid var(--line-soft);
    align-items: center;
  }

  .compact .date {
    padding-top: 0;
  }

  .compact .title {
    font-size: 15px;
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
      gap: 7px;
      padding: 14px 0;
    }

    .date {
      padding-top: 0;
      font-size: 11px;
    }

    .title {
      font-size: 15px;
      line-height: 1.45;
    }

    .summary {
      font-size: 12px;
    }
  }
</style>
